# Copy this file to .env.local and fill in your values.
# Find these in: Supabase Dashboard → Your Project → Settings → API
#
# NEXT_PUBLIC_ prefix means these values are safe to expose in the browser.
# The anon key is intentionally public — Row Level Security in the DB controls access.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Find this in: Geoapify Dashboard → Projects → your project → API key
# Free tier, no card required. Used for address autocomplete at signup and
# on the profile page.
NEXT_PUBLIC_GEOAPIFY_API_KEY=your-geoapify-api-key-here
